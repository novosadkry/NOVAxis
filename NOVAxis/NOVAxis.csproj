<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>5.2.0</Version>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- The frontend builds through npm, so msbuild must not glob it -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Web/ClientApp/**</DefaultItemExcludes>

    <!--
      The frontend is built along with the project, so running the bot serves the client
      that matches the code rather than whatever was in wwwroot from last time. The image
      and CI build it in a step of their own and pass -p:BuildClientApp=false.
    -->
    <BuildClientApp Condition="'$(BuildClientApp)' == ''">true</BuildClientApp>
    <ClientAppDirectory>$(MSBuildProjectDirectory)/Web/ClientApp</ClientAppDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildClientApp)' == 'true'">
    <!--
      Named rather than globbed: an Exclude is applied after the Include has walked the
      tree, and walking node_modules on every build costs more than the build itself.
    -->
    <ClientAppInput Include="$(ClientAppDirectory)/src/**" />
    <ClientAppInput Include="$(ClientAppDirectory)/index.html" />
    <ClientAppInput Include="$(ClientAppDirectory)/package.json" />
    <ClientAppInput Include="$(ClientAppDirectory)/package-lock.json" />
    <ClientAppInput Include="$(ClientAppDirectory)/tsconfig.json" />
    <ClientAppInput Include="$(ClientAppDirectory)/vite.config.ts" />
  </ItemGroup>
  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="libsodium.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="opus.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="libdave.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic.SDK" Version="5.0.0" />
    <PackageReference Include="Lavalink4NET" Version="4.0.27" />
    <PackageReference Include="Lavalink4NET.Discord.NET" Version="4.0.27" />
    <PackageReference Include="Lavalink4NET.InactivityTracking" Version="4.0.27" />
    <PackageReference Include="Lavalink4NET.Integrations.Lavasearch" Version="4.0.27" />
    <PackageReference Include="Lavalink4NET.Integrations.Lavasrc" Version="4.0.27" />
    <PackageReference Include="Lavalink4NET.Integrations.TextToSpeech" Version="4.0.27" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.3" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0-preview.3.efcore.9.0.0" />
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="Discord.Net.Commands" Version="3.20.1" />
    <PackageReference Include="Discord.Net.Core" Version="3.20.1" />
    <PackageReference Include="Discord.Net.Rest" Version="3.20.1" />
    <PackageReference Include="Discord.Net.Webhook" Version="3.20.1" />
    <PackageReference Include="Discord.Net.WebSocket" Version="3.20.1" />
    <PackageReference Include="Discord.Net.Interactions" Version="3.20.1" />
    <PackageReference Include="Discord.Net.Dave" Version="3.20.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
  </ItemGroup>

  <Target Name="CheckClientAppTooling" Condition="'$(BuildClientApp)' == 'true'">
    <Exec Command="npm --version" WorkingDirectory="$(ClientAppDirectory)"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="ClientAppNpmExitCode" />
    </Exec>
    <!-- Saying so beats building a bot which quietly serves nothing -->
    <Error Condition="'$(ClientAppNpmExitCode)' != '0'"
           Text="The web player needs npm to build. Install Node 22, or pass -p:BuildClientApp=false to build the bot without a frontend." />
  </Target>

  <Target Name="RestoreClientApp" DependsOnTargets="CheckClientAppTooling"
          Condition="'$(BuildClientApp)' == 'true' And !Exists('$(ClientAppDirectory)/node_modules')">
    <Message Importance="high" Text="Installing web player dependencies..." />
    <Exec Command="npm ci" WorkingDirectory="$(ClientAppDirectory)" />
  </Target>

  <!--
    Before the build rather than after, so the files exist by the time publish decides what
    to carry. Skipped whenever nothing under ClientApp has changed since the last one.
  -->
  <Target Name="BuildClientApp" BeforeTargets="Build" DependsOnTargets="RestoreClientApp"
          Condition="'$(BuildClientApp)' == 'true'"
          Inputs="@(ClientAppInput)" Outputs="$(MSBuildProjectDirectory)/wwwroot/index.html">
    <Message Importance="high" Text="Building the web player frontend..." />
    <Exec Command="npm run build:bot" WorkingDirectory="$(ClientAppDirectory)" />
  </Target>

</Project>
